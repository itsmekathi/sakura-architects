# Database. SQLite file locally; use a Postgres URL (with @payloadcms/db-postgres) in production.
DATABASE_URL=file:./sakura.db
# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=
# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Email. Leave SMTP_HOST empty to log emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=studio@example.com
EMAIL_FROM_NAME=Sakura Architects
# Where new contact-form enquiries are sent (falls back to the email in Site settings)
STUDIO_INBOX_EMAIL=

# Used by `npm run seed` when no users exist yet
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now

# On Vercel these are added for you by the Storage integrations:
#   DATABASE_URL (Neon, postgres://…)  → switches the app to Postgres
#   BLOB_READ_WRITE_TOKEN              → stores uploads in Vercel Blob
# NEXT_PUBLIC_SERVER_URL can be omitted on Vercel (the production domain is used).

# Google sign-in for site visitors (optional; the button is hidden when unset). See README → "Google sign-in".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
